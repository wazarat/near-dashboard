# Copy to .env.local (gitignored). Nothing here is needed to build the site; these only enable `npm run refresh` sources
# and the public links. Never commit .env.local, a JWT or any key.

# Google Cloud project with the BigQuery API enabled. Locally the scripts use Application Default Credentials
# (`gcloud auth application-default login`); no service-account key file is needed or supported.
GCP_PROJECT_ID=
# Optional: per-query byte cap for BigQuery jobs (default 20 GB). Backfills are also capped at BQ_BACKFILL_MAX_BYTES (default 300 GB).
BQ_MAX_BYTES=20000000000
BQ_BACKFILL_MAX_BYTES=300000000000

# NEAR Intents Explorer API JWT from https://partners.near-intents.org (1 request per 5 seconds).
# When empty, the Intents source is skipped and DefiLlama's NEAR Intents daily volume stands in, labelled as such.
NEAR_INTENTS_JWT=
# How many days of 1Click swaps the backfill walks back from today (default 90).
INTENTS_BACKFILL_DAYS=90

# Optional: CoinGecko Demo key, price/market-cap fallback only.
COINGECKO_DEMO_KEY=

# Optional: NearBlocks API key. Without it the free tier allows about 6 calls a minute, which the daily token
# holder counts fit inside; a key only makes the refresh faster.
NEARBLOCKS_API_KEY=

# Optional: Tally form links. Buttons stay hidden while unset.
NEXT_PUBLIC_TALLY_SUBMIT_URL=
NEXT_PUBLIC_TALLY_CORRECT_URL=

# Public origin of this atlas: canonical URLs, Open Graph, sitemap and robots read it. Planned domain shown;
# set it to the current Vercel URL until DNS for near.canhav.com is live. Defaults to the planned domain when unset.
NEXT_PUBLIC_SITE_URL=https://near.canhav.com
# The sibling CanHav atlas linked from the footer. The link stays hidden while unset.
NEXT_PUBLIC_SIBLING_ATLAS_URL=https://robinhood.canhav.com

# Login wall (Clerk). One Clerk application serves canhav.com and the atlases, so its production keys only work on
# canhav.com hosts. Leave both empty to run with the wall off, which is how local runs, CI and the page checks work.
# For the login-wall checks (`npm run e2e:auth`) use the development pair (pk_test_ and sk_test_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# GitHub Actions only (repository secrets, not .env.local): the workflow authenticates to BigQuery with
# Workload Identity Federation, so it needs GCP_WORKLOAD_IDENTITY_PROVIDER and GCP_SERVICE_ACCOUNT as secrets.
