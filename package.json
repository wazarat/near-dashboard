{
  "name": "near-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "NEAR Ecosystem Atlas: an independent map of the NEAR and Aurora ecosystem with daily history, chain activity and NEAR Intents volume, built for NEAR Hackathon 2026 (track: thesis).",
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "thesis": "tsx scripts/thesis.ts",
    "rebuild": "tsx scripts/build-data.ts && tsx scripts/thesis.ts",
    "prebuild": "npm run rebuild",
    "predev": "npm run rebuild",
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "refresh": "tsx scripts/refresh.ts",
    "review": "tsx scripts/review.ts",
    "seed:map": "tsx scripts/seed-defillama-map.ts",
    "seed:contracts": "tsx scripts/seed-contracts.ts",
    "screenshots": "playwright test -c e2e/playwright.config.ts && node -e \"const fs=require('fs');fs.mkdirSync('docs/screenshots',{recursive:true});let n=0;for(const f of fs.readdirSync('e2e/screenshots'))if(f.endsWith('.png')&&!f.endsWith('-light.png')){fs.copyFileSync('e2e/screenshots/'+f,'docs/screenshots/'+f);n++}console.log('copied',n,'dark screenshots to docs/screenshots')\""
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google-cloud/bigquery": "^8.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "serve": "^14.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
